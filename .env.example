# Copy this file to .env and adjust values. Every setting uses the APP_ prefix.
# Lists and dictionaries are JSON.

APP_NAME="AI Coding Assistant"
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
# text for humans, json for log collectors
APP_LOG_FORMAT=text
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ----- Ollama -----
# 127.0.0.1 is faster than "localhost" on Windows (no IPv6 attempt first)
APP_OLLAMA_HOST=http://127.0.0.1:11434
APP_OLLAMA_MODEL=qwen2.5-coder:7b
APP_OLLAMA_TIMEOUT_SECONDS=300
APP_OLLAMA_TEMPERATURE=0.2
APP_OLLAMA_KEEP_ALIVE=10m
APP_OLLAMA_NUM_CTX=8192
APP_OLLAMA_MAX_TOKENS=2048

# ----- Database -----
# SQLite now; for PostgreSQL: pip install "psycopg[binary]" and use
# APP_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/assistant
APP_DATABASE_URL=sqlite:///./data/assistant.db
# true: create tables at startup (development). Production: false + "alembic upgrade head".
APP_DATABASE_AUTO_CREATE=true

# Review area for generated tests and backups of every file the assistant writes.
APP_DATA_DIR=./data

# ----- Repository access -----
# Folders repositories must live in, e.g. ["D:/projects","D:/llm-learning"]. [] = any folder.
APP_ALLOWED_REPOSITORY_ROOTS=[]
APP_MAX_FILE_BYTES=1000000
APP_MAX_SEARCH_RESULTS=200

# ----- Agent -----
APP_AGENT_MAX_STEPS=8
APP_AGENT_TOOL_OUTPUT_CHARS=6000
APP_AGENT_HISTORY_MESSAGES=10

# ----- Analysis and changes -----
APP_ANALYSIS_MAX_LINES=300
APP_CHANGE_MAX_FILES=3
APP_CHANGE_MAX_FILE_LINES=800

# ----- Test execution -----
# Only commands listed in APP_TEST_COMMANDS can run (see app/core/config.py for the defaults).
APP_TEST_EXECUTION_ENABLED=true
APP_TEST_TIMEOUT_SECONDS=300

# ----- Fix sessions (backend-enforced limits) -----
APP_FIX_MAX_ATTEMPTS=3
APP_FIX_MAX_LLM_CALLS=20
APP_FIX_SESSION_TIMEOUT_SECONDS=1800
APP_FIX_INVESTIGATION_MAX_STEPS=4
APP_FIX_MAX_CHANGED_LINES=60
APP_FIX_MAX_CONCURRENT_SESSIONS=1
APP_FIX_SANDBOX_MAX_FILES=20000
APP_FIX_SANDBOX_MAX_BYTES=200000000
